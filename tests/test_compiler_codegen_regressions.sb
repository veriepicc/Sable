import mem

// Regression tests for compiler codegen bugs uncovered while rewriting stdlib:
// 1. view field store & compound assign clobbering RCX-bound param 0
// 2. emit_condition_false_jump pure-rhs evaluation clobbering R11 lhs_reg
// 3. stack-struct reassignment copying only 8 bytes instead of total_size
// 4. leaf IndexExpr read/write, mem_write, and compound assign clobbering RCX
// 5. memcpy clobbering Win64 non-volatile RDI/RSI across loops
// 6. PreInc/PreDec/PostInc/PostDec out of sync with register_bindings_
// 7. while-loop mut locals bound to volatile R11 across function calls
// 8. IndexExpr store through immutable `let` pointer binding
// 9. 64-bit immediate fallback clobbering its own operand when dst==R11
//    (imul/add/and/or/xor with immediates that do not fit imm32)

view Box {
    a: int @ 0
    b: int @ 8
    c: int @ 16
}

struct Triple {
    x: int,
    y: int,
    z: int,
}

function Box mutate_view_rcx(Box v, int delta) {
    v.a = 10
    v.b = 20
    v.c = 30
    v.b += delta
    v.c += 5
    return v
}

function int check_pure_cmp_lhs_preservation(Box v, int used, int extra) {
    if v.c < used + extra {
        return 1
    }
    return 0
}

function Triple make_triple(int x, int y, int z) {
    return Triple { x: x, y: y, z: z }
}

function Triple bump_triple(Triple t) {
    t.x = t.x + 1
    t.y = t.y + 2
    t.z = t.z + 3
    return t
}

function ptr leaf_write_index_return_rcx(ptr p, int idx, int val) {
    let arr = p as *i64
    arr[idx] = val
    return p
}

function ptr leaf_read_index_return_rcx(ptr p, int idx) {
    let arr = p as *i64
    let v = arr[idx]
    if v != 777 {
        return 0
    }
    return p
}

function ptr leaf_mem_write_return_rcx(ptr p, int val) {
    mem_write(p, val)
    return p
}

function int test_while_call_loop_counter(str s) {
    let n = string_length(s)
    let p = s as ptr
    var i = 0
    var hits = 0
    while i < n {
        var j = i + 1
        while j < n {
            let c = mem.read8(p + j)
            if c == 120 {
                hits++
                break
            }
            j++
        }
        i++
    }
    return hits
}

function int test_inc_dec_sync(ptr p, int lo, int hi) {
    var arr = p as *i64
    var i = lo + 1
    while i <= hi {
        let key = arr[i]
        var j = i - 1
        while j >= lo {
            let cur = arr[j]
            if cur <= key {
                break
            }
            arr[j + 1] = cur
            j--
        }
        arr[j + 1] = key
        i++
    }
    var k = 0
    let a = ++k
    let b = k++
    let c = --k
    let d = k--
    if a != 1 or b != 1 or c != 1 or d != 1 or k != 0 {
        return -1
    }
    return arr[0] + arr[1] + arr[2]
}

function int test_memcpy_nonvolatile_preservation(ptr dst, ptr src) {
    var sum = 0
    var i = 0
    while i < 50 {
        memcpy(dst, src, 32)
        sum += mem.read(dst)
        i++
    }
    return sum
}

function int test_64bit_imm_operands() {
    // 2654435761 overflows imm32: the compiler must not clobber the operand
    // register while materializing the 64-bit constant (hft mix() regression).
    let salt: i64 = 0x1122334455667788
    let m: i64 = salt * 2654435761
    if m != 0x33445566188fed08 { return -1 }

    // x + 2^32 (imm32 overflow)
    let base: i64 = 123456789
    if base + 4294967296 != 4418424085 { return -2 }

    // 64-bit and/or/xor with immediates outside imm32
    let v: i64 = 0x1FFFFFFFF
    if (v & 0x100000000) != 0x100000000 { return -3 }
    if (v | 0x100000000) != 0x1FFFFFFFF { return -4 }
    if (v ^ 0x100000000) != 0xFFFFFFFF { return -5 }

    // two independent products sharing the scratch path (fits signed i64)
    let a: i64 = 0xDEADBEEF
    if a * 0x1234567 != 71314180129111337 { return -6 }
    return 0
}

// 10: nested pure subexpressions must not reuse a scratch register that an
// outer frame still holds live. A non-refcounted scratch set released the
// register early, so `(A) + (B)` for two nested pure exprs compiled B into
// the same register that held A.
function int test_nested_scratch_refcount() {
    // both sides are two-level pure exprs; both R11 and R10 stay live
    let a = ((1 | 2) ^ (3 - 4))          // 3 ^ -1 = -4
    let b = ((5 + 6) - (7 | 8))          // 11 - 15 = -4
    if a != -4 { return -1 }
    if b != -4 { return -2 }
    if (a + b) != -8 { return -3 }
    if (a ^ b) != 0 { return -4 }

    // longer chains force deeper scratch nesting
    let c = ((1 + 2) + (3 - 4)) + ((5 * 6) - (7 ^ 8))   // 2 + 15 = 17
    if c != 17 { return -5 }

    let d = (((10 - 1) | 2) ^ (3 + 4)) + (((20 / 2) - 1) & 7)  // (11 ^ 7) + 1 = 12 + 1 = 13
    if d != 13 { return -6 }

    // the original fuzz find: a four-operand mix of nested pure exprs
    let e = (((754 - 515) ^ (713 + 317)) - ((196 | -453) ^ (291 - 364)))  // 1257 - 328 = 929
    if e != 929 { return -7 }
    return 0
}

function int main() {
    // 1 & 2: view RCX preservation + pure cmp rhs
    let raw = malloc(24)
    let b = raw as Box
    let b2 = mutate_view_rcx(b, 7)
    if b2 != b or b.a != 10 or b.b != 27 or b.c != 35 {
        free(raw)
        return 1
    }
    if check_pure_cmp_lhs_preservation(b, 10, 20) != 0 {
        free(raw)
        return 2
    }
    if check_pure_cmp_lhs_preservation(b, 20, 20) != 1 {
        free(raw)
        return 3
    }
    free(raw)

    // 3: stack struct reassignment
    var t = make_triple(1, 2, 3)
    t = bump_triple(t)
    t = bump_triple(t)
    if t.x != 3 or t.y != 6 or t.z != 9 {
        return 4
    }

    // 4 & 8: leaf IndexExpr/mem_write RCX preservation + immutable ptr index write
    let buf = malloc(32)
    let p1 = leaf_write_index_return_rcx(buf, 2, 777)
    if p1 != buf {
        free(buf)
        return 5
    }
    if leaf_read_index_return_rcx(buf, 2) != buf {
        free(buf)
        return 6
    }
    if leaf_mem_write_return_rcx(buf, 123) != buf or mem.read(buf) != 123 {
        free(buf)
        return 7
    }

    // 5: memcpy non-volatile preservation
    let src = malloc(32)
    mem.write(src, 10)
    if test_memcpy_nonvolatile_preservation(buf, src) != 500 {
        free(src)
        free(buf)
        return 8
    }
    free(src)

    // 6: inc/dec sync in registerized loops
    var arr = buf as *i64
    arr[0] = 30
    arr[1] = 10
    arr[2] = 20
    if test_inc_dec_sync(buf, 0, 2) != 60 or arr[0] != 10 or arr[1] != 20 or arr[2] != 30 {
        free(buf)
        return 9
    }
    free(buf)

    // 7: while-loop var across mem.read8 calls
    if test_while_call_loop_counter("axbxcx") != 5 {
        return 10
    }

    // 9: 64-bit immediates must not clobber their own operand register
    if test_64bit_imm_operands() != 0 {
        return 11
    }

    // 10: nested pure exprs must not reuse an outer frame's live scratch reg
    let nested = test_nested_scratch_refcount()
    if nested != 0 {
        return 12 + (-nested)
    }

    // 11: runtime division guards (no #DE fault on zero divisor or MIN/-1)
    let dg = test_runtime_div_guards()
    if dg != 0 {
        return 20 + dg
    }

    // 12: null pointer indexing must not fault (reads yield 0, stores ignored)
    let ng = test_null_index_guards()
    if ng != 0 {
        return 30 + ng
    }

    // 13: null struct pointers and computed out-of-range indices must not fault
    let fg = test_null_field_and_oob_guards()
    if fg != 0 {
        return 40 + fg
    }

    // 14: an idiv (from %) must not leave a stale value registered in RDX, and the
    // peephole must not delete a move that a branch jumps directly onto.
    let rg = test_divmod_rdx_and_jump_target_guards()
    if rg != 0 {
        return 50 + rg
    }

    // 15: an inlined function's parameter must shadow a caller local of the same
    // name (the inline alias is the parameter, not the caller's variable).
    let sg = test_inline_param_shadowing()
    if sg != 0 {
        return 60 + sg
    }

    // 16: an inlined function's null guard must test ITS argument, not a caller
    // local that shares the parameter's name.
    let ng2 = test_inline_param_null_guard()
    if ng2 != 0 {
        return 70 + ng2
    }

    return 0
}

// Regression: when a single-use function is inlined, its parameter names are
// registered as inline aliases. Several codegen paths looked the caller's own
// symbol up BEFORE the alias, so a caller local sharing a parameter name captured
// the inlined body's reads. Below, rd's parameter is named `m` and main also has a
// local `m`: the old order made rd(m) return m.m instead of t.m.
view ShadowBox {
    tag: int @ 0
    mark: int @ 8
}

function ShadowBox shadow_make(int tag, int mark) {
    var h = malloc(16) as ShadowBox
    if h != 0 {
        h.tag = tag
        h.mark = mark
    }
    return h
}

function int shadow_read_tag(ShadowBox m) {
    if m == 0 {
        return 0 - 1
    }
    return m.tag
}

function int test_inline_param_shadowing() {
    let m = shadow_make(7, 8)
    let t = shadow_make(30, 40)
    // direct field reads of t are correct
    if t.tag != 30 { return 1 }
    // the inlined accessor must see t (its argument), not the caller's m
    if shadow_read_tag(t) != 30 { return 2 }
    // and the caller's own m is unaffected
    if shadow_read_tag(m) != 7 { return 3 }
    if m.tag != 7 { return 4 }
    return 0
}

// the `if p == 0` guard inside an inlined function must test the function's own
// argument. with a caller local named like the parameter, the old comparison fast
// path tested the caller's (dangling) handle instead and dereferenced freed memory.
function int shadow_check_null(ShadowBox m) {
    if m == 0 {
        return 0 - 1
    }
    return m.mark
}

function int test_inline_param_null_guard() {
    let m = shadow_make(1, 2)
    if shadow_check_null(m) != 2 { return 1 }
    if shadow_check_null(0 as *ShadowBox) != (0 - 1) { return 2 }
    if m.mark != 2 { return 3 }
    return 0
}

// Regression: `%` uses RDX as the idiv remainder register. A parameter that lands
// in RDX (the 2nd argument) used to be destroyed by the divide and read back
// clobbered. Also covers the peephole copy-back rule deleting `mov r8, rax` when a
// conditional branch jumps straight onto it.
function i64 divmod_param_in_rdx(i64 v, i64 m) {
    var r = v % m
    var pad1 = 0
    var pad2 = 0
    if r < 0 { r = r + m }
    if r < 0 { r = 99 }
    if pad1 > 0 { pad2 = 1 }
    if pad2 > 0 { pad1 = 2 }
    if pad1 > 1 { pad2 = 3 }
    return r
}

function int test_divmod_rdx_and_jump_target_guards() {
    // m is the 2nd parameter => bound to RDX by the leaf register plan. after the
    // `%`, m must still be 3, so the correction gives -1 + 3 == 2.
    if divmod_param_in_rdx(0 - 1, 3) != 2 { return 1 }
    if divmod_param_in_rdx(0 - 7, 5) != 3 { return 2 }
    if divmod_param_in_rdx(10, 3) != 1 { return 3 }

    // the same modulo through a parameter that lands in RCX must also hold
    if divmod_param_in_rcx(3, 0 - 1) != 2 { return 4 }

    // a plain modulo used twice still yields the truncated remainders (-8 % 3 == -2,
    // so a + b == -4)
    if divmod_twice(0 - 8, 3) != (0 - 4) { return 5 }
    return 0
}

function i64 divmod_param_in_rcx(i64 m, i64 v) {
    var r = v % m
    var pad1 = 0
    var pad2 = 0
    if r < 0 { r = r + m }
    if r < 0 { r = 99 }
    if pad1 > 0 { pad2 = 1 }
    if pad2 > 0 { pad1 = 2 }
    if pad1 > 1 { pad2 = 3 }
    return r
}

function i64 divmod_twice(i64 v, i64 m) {
    var a = v % m
    var b = v % m
    return a + b
}

struct NullGuardPoint {
    x: int
    y: int
}

function int test_null_field_and_oob_guards() {
    // a null struct pointer: reads yield 0 instead of faulting
    let p: *NullGuardPoint = 0 as *NullGuardPoint
    if p.x != 0 { return 1 }
    if p.y != 0 { return 2 }

    // a computed index that runs off the end of a heap array must read 0
    let arr = [10, 20, 30]
    let big = 5000000
    if arr[big] != 0 { return 3 }
    let neg = 0 - 4
    if arr[neg] != 0 { return 4 }

    // in-range computed index still returns the real element
    let i = 1
    if arr[i] != 20 { return 5 }

    return 0
}

function int test_null_index_guards() {
    let p: *int = 0 as *int
    if p[3] != 0 { return 1 }
    p[3] = 99              // must be ignored
    if p[3] != 0 { return 2 }

    let s: str = 0 as str
    if s[0] != 0 { return 3 }

    let b: *byte = 0 as *byte
    if b[7] != 0 { return 4 }
    b[7] = 5               // must be ignored

    // real pointers keep working
    let q = malloc(16) as *int
    q[2] = 42
    if q[2] != 42 { free(q); return 5 }
    free(q)
    return 0
}

// runtime div/mod must never fault: /0 and %0 yield 0, INT64_MIN/-1 wraps.
function int test_runtime_div_guards() {
    let zero = 0
    let one = 1
    let minus_one = 0 - 1
    let min_int = 0 - 9223372036854775807 - 1

    if min_int / minus_one != min_int { return 1 }
    if min_int % minus_one != 0 { return 2 }
    if 20 / minus_one != -20 { return 3 }
    if 0 - 20 != 0 && (0 - 20) / minus_one != 20 { return 4 }
    if 20 % minus_one != 0 { return 5 }
    let q = 100 / zero
    if q != 0 { return 6 }
    let r = 100 % zero
    if r != 0 { return 7 }
    if 7 / one != 7 or 7 % one != 0 { return 8 }
    if 0 / 500 != 0 { return 9 }
    return 0
}
