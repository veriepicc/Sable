import strbuf

function int main() {
    let n = 300000;
    let b = strbuf_new();
    for i in range(0, n) {
        strbuf_append(b, "ord|");
        strbuf_append_int(b, i);
        strbuf_append(b, "|ok\n");
    }
    let big = strbuf_to_string(b);
    strbuf_free(b);
    let len = string_length(big);

    var sum = 0;
    let m = 200000;
    for k in range(0, m) {
        let start = (k * 7) % (len - 16);
        let slice = string_substring(big, start, 16);
        sum = sum + slice[0];
        free(slice);
    }
    free(big);
    return (len + sum) & 255;
}
