import text

// This file deliberately triggers several warning kinds. It must still compile
// and run identically with warnings off (the default), and each -W flag should
// surface the matching diagnostic. Warnings never change generated code.

function int shadow_and_unused() {
    let outer = 10
    let unused_local = 99        // unused-local
    if outer > 0 {
        let outer = 20           // shadowed-variable (shadows the outer `outer`)
        return outer
    }
    return outer
}

function int unused_param_fn(int used, int not_used) {   // unused-parameter
    return used
}

function int const_and_empty() {
    if 1 {                       // const-condition
        return 7
    }
    var n = 0
    while false {                // const-condition
        n++
    }
    return n
}

function int self_ops() {
    var a = 5
    a = a                        // self-assignment
    let b = 3
    if b == b {                  // redundant-compare
        return a
    }
    return 0
}

function int unreachable_after_return() {
    return 1
    let dead = 2                 // unreachable-code
    return dead
}

function int switch_issues(int mode) {
    switch mode {
    case 1:
        return 10
    case 1:                      // duplicate-switch-case
        return 11
    else:
        return 0
    }
}

function void empty_body() {     // empty-function
}

function int loop_issues() {
    var total = 0
    for i in range(5, 2) {       // loop-never-runs
        total += i
    }
    return total
}

function int bool_int() {
    let flag = true
    if flag == 1 {               // bool-int-compare
        return 1
    }
    return 0
}

// exercises the second batch of warning kinds. All of these are legitimate code
// that must still compile and run identically with warnings off.
constant ZERO: int = 0
function void produce(int v) { }        // empty-function, unused-parameter

function int shadow_param(int value) {
    let value = 5                 // shadowed-parameter
    return value
}

function int loop_var_ignored() {
    var total = 0
    for i in range(0, 3) {        // unused-loop-var
        total = total + 1
    }
    return total
}

function int dup_condition(int a) {
    if a == 1 {                   // duplicate-condition (second branch repeats)
        return 1
    } else if a == 1 {
        return 2
    }
    return 0
}

function int div_by_named_zero(int a) {
    let n = a / ZERO              // div-by-zero-const
    return n
}

function int big_shift() {
    let n = 1 << 200              // shift-count
    return n
}

function int const_compare() {
    if 3 == 3 {                   // comparison-always-true
        return 1
    }
    return 0
}

function int redundant_cast() {
    let n = 42 as int             // redundant-cast
    return n
}

function int assign_cond() {
    var a = 0
    if a = 1 {                    // assign-in-condition
        return a
    }
    return 0
}

function int returns_void() {
    let ignored = produce(1)      // void-value-used
    return 0
}

function int new_warning_kinds() {
    let sp = shadow_param(0)
    let lv = loop_var_ignored()
    let dc = dup_condition(1)
    let dz = div_by_named_zero(10)
    let bs = big_shift()
    let cc = const_compare()
    let rc = redundant_cast()
    let ac = assign_cond()
    let rv = returns_void()
    if lv != 3 { return 1 }
    if dc != 1 { return 2 }
    if dz != 0 { return 3 }       // the literal-zero-divisor guard normalises to 0 only at runtime
    if cc != 1 { return 4 }
    if rc != 42 { return 5 }
    if rv != 0 { return 6 }
    // keep the rest live so they are still analyzed
    if sp == 5 { return cc }
    if bs == 0 { return ac }
    return 0
}

fn main() -> int {
    let s = shadow_and_unused()
    let u = unused_param_fn(1, 2)
    let c = const_and_empty()
    let so = self_ops()
    let sw = switch_issues(1)
    let lp = loop_issues()
    let bi = bool_int()
    let nw = new_warning_kinds()
    if s != 20 { return 1 }
    if u != 1 { return 2 }
    if c != 7 { return 3 }
    if so != 5 { return 4 }
    if sw != 10 { return 5 }
    if lp != 0 { return 6 }
    if bi != 1 { return 7 }
    if nw != 0 { return 8 }
    return 0
}

