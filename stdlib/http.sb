import mem

// HTTP client helpers built on WinHTTP using typed function pointers and zero-copy views.

enum HttpUrlOffset {
    Secure = 0,
    Port = 8,
    Host = 16,
    Path = 24,
}

enum HttpResponseOffset {
    Status = 0,
    Body = 8,
    RawHeaders = 16,   // CRLF-separated header block (owned) or 0
    BodyBytes = 24,    // raw body buffer (owned), binary-safe, NOT null-terminated
    BodyLen = 32,      // length of BodyBytes in bytes
}

enum HttpWidePartsOffset {
    UserAgentW = 0,
    MethodW = 8,
    HostW = 16,
    PathW = 24,
}

// Per-client configuration. A zeroed config is the default: system proxy,
// HTTP/1.1, full TLS validation, redirects followed. Strings are borrowed, not
// owned, and must outlive the request that reads them.
enum HttpConfigOffset {
    Proxy = 0,              // str  "host:port", or 0 for the system proxy
    ProxyBypass = 8,        // str  bypass list or 0
    UserAgent = 16,         // str  default User-Agent or 0
    CookieJar = 24,         // ptr  HttpCookieJar or 0
    TimeoutMs = 32,         // int  connect/send/receive timeout
    HttpVersion = 40,       // int  HttpVersion
    Tls = 48,               // int  HttpTlsVerify
    FollowRedirects = 56,   // int  bool
    ProxyAuthUser = 64,     // str
    ProxyAuthPass = 72,     // str
    EnableCookies = 80,     // int  bool: auto add/absorb cookies
    StreamSink = 88,        // ptr  HttpSinkFn or 0
    StreamContext = 96,     // ptr  passed through to the sink
}

enum HttpConfigSize { ConfigBytes = 104 }

// HTTP protocol preference.
enum HttpVersion {
    Auto = 0,
    Http11 = 1,
    Http2 = 2,
}

// Cookie jar: parallel heap arrays of names/values/domain/path/secure flags.
enum HttpCookieJarOffset {
    Names = 0,    // ptr array of str
    Values = 8,   // ptr array of str
    Domains = 16, // ptr array of str
    Paths = 24,   // ptr array of str
    Secure = 32,  // ptr array of int
    Count = 40,   // int
    Cap = 48,     // int
}

enum HttpCookieJarSize { JarBytes = 56 }

view HttpUrl {
    secure: int @ HttpUrlOffset.Secure
    port: int @ HttpUrlOffset.Port
    host: str @ HttpUrlOffset.Host
    path: str @ HttpUrlOffset.Path
}

view HttpResponse {
    status: int @ HttpResponseOffset.Status
    body: str @ HttpResponseOffset.Body
    raw_headers: str @ HttpResponseOffset.RawHeaders
    body_bytes: ptr @ HttpResponseOffset.BodyBytes
    body_len: int @ HttpResponseOffset.BodyLen
}

view HttpConfig {
    proxy: str @ HttpConfigOffset.Proxy
    proxy_bypass: str @ HttpConfigOffset.ProxyBypass
    user_agent: str @ HttpConfigOffset.UserAgent
    cookie_jar: ptr @ HttpConfigOffset.CookieJar
    timeout_ms: int @ HttpConfigOffset.TimeoutMs
    http_version: int @ HttpConfigOffset.HttpVersion
    tls: int @ HttpConfigOffset.Tls
    follow_redirects: int @ HttpConfigOffset.FollowRedirects
    proxy_auth_user: str @ HttpConfigOffset.ProxyAuthUser
    proxy_auth_pass: str @ HttpConfigOffset.ProxyAuthPass
    enable_cookies: int @ HttpConfigOffset.EnableCookies
    stream_sink: ptr @ HttpConfigOffset.StreamSink
    stream_context: ptr @ HttpConfigOffset.StreamContext
}

view HttpCookieJar {
    names: ptr @ HttpCookieJarOffset.Names
    values: ptr @ HttpCookieJarOffset.Values
    domains: ptr @ HttpCookieJarOffset.Domains
    paths: ptr @ HttpCookieJarOffset.Paths
    secure: ptr @ HttpCookieJarOffset.Secure
    count: int @ HttpCookieJarOffset.Count
    cap: int @ HttpCookieJarOffset.Cap
}

view HttpWideParts {
    user_agent_w: ptr @ HttpWidePartsOffset.UserAgentW
    method_w: ptr @ HttpWidePartsOffset.MethodW
    host_w: ptr @ HttpWidePartsOffset.HostW
    path_w: ptr @ HttpWidePartsOffset.PathW
}

using WinHttpOpenFn = fn(ptr, int, ptr, ptr, int) -> ptr
using WinHttpSetTimeoutsFn = fn(ptr, int, int, int, int) -> int
using WinHttpConnectFn = fn(ptr, ptr, int, int) -> ptr
using WinHttpOpenRequestFn = fn(ptr, ptr, ptr, ptr, ptr, ptr, int) -> ptr
using WinHttpSendRequestFn = fn(ptr, ptr, int, ptr, int, int, int) -> int
using WinHttpReceiveResponseFn = fn(ptr, ptr) -> int
using WinHttpQueryHeadersFn = fn(ptr, int, ptr, ptr, ptr, ptr) -> int
using WinHttpQueryDataAvailableFn = fn(ptr, ptr) -> int
using WinHttpReadDataFn = fn(ptr, ptr, int, ptr) -> int
using WinHttpCloseHandleFn = fn(ptr) -> int
using WinHttpAddRequestHeadersFn = fn(ptr, ptr, int, int) -> int
using WinHttpSetOptionFn = fn(ptr, int, ptr, int) -> int
using WinHttpWriteDataFn = fn(ptr, ptr, int, ptr) -> int
using WinHttpSetCredentialsFn = fn(ptr, int, int, ptr, ptr, ptr) -> int
using WinHttpQueryAuthSchemesFn = fn(ptr, ptr, ptr, ptr) -> int

// Callback for streaming bodies. Invoked with a caller-supplied context, the
// next chunk of body bytes, and its length; return 0 to abort the transfer,
// non-zero to continue. Mirrors libcurl's write callback userdata argument.
using HttpSinkFn = fn(ptr, ptr, int) -> int

// WinHTTP option numbers (winhttp.h). Set with WinHttpSetOption.
enum HttpOption {
    ConnectTimeout = 3,
    SendTimeout = 4,
    ReceiveTimeout = 5,
    Proxy = 38,
    SecureProtocols = 84,
    RedirectPolicy = 88,
    EnableHttpProtocol = 133,
    DisableFeature = 109,
}

// WINHTTP_OPTION_DISABLE_FEATURE bits.
enum HttpDisableFeature { Http2OverTcp = 1024 }

// WINHTTP_OPTION_ENABLE_HTTP_PROTOCOL / WINHTTP_PROTOCOL_FLAG_* values.
enum HttpProtocolFlag {
    Http2 = 1,
    Http3 = 2,
}

// WINHTTP_OPTION_SECURE_PROTOCOLS bits (winhttp.h).
enum HttpSecureProtocol {
    Ssl2 = 4,
    Ssl3 = 8,
    Tls10 = 16,
    Tls11 = 32,
    Tls12 = 2048,
    Tls13 = 8192,
}

// WINHTTP_OPTION_REDIRECT_POLICY values.
enum HttpRedirectPolicy {
    Never = 0,
    DisallowHttpsToHttp = 1,
    Always = 2,
}

// WINHTTP_OPTION_PROXY dwAccessType values.
enum HttpProxyAccess {
    Direct = 1,
    NamedProxy = 3,
    DefaultProxy = 5,
}

// TLS verification levels for http_config_set_tls (mirrors CURLOPT_SSL_VERIFYPEER
// plus WINHTTP_OPTION_SECURITY_FLAGS). VerifyDefault keeps WinHTTP's normal
// chain + hostname validation.
enum HttpTlsVerify {
    VerifyDefault = 0,   // full validation (default)
    IgnoreCertCnFailure = 1,   // WINHTTP_FLAG_SECURITY_IGNORE_CERT_CN_INVALID
    IgnoreCertDateFailure = 2, // WINHTTP_FLAG_SECURITY_IGNORE_CERT_DATE_INVALID
    IgnoreAll = 3,       // both of the above (CURLOPT_SSL_VERIFYPEER=0-ish)
}

// WINHTTP_OPTION_SECURITY_FLAGS bits used by HttpTlsVerify.
enum HttpSecurityFlag {
    CertCnInvalid = 4096,
    CertDateInvalid = 8192,
}

function str http_empty_text() {
    return string_substring("", 0, 0)
}

function ptr http_make_zero(int size) {
    return mem.make_zero(size)
}

function bool http_is_digit(int ch) {
    return ch >= 48 and ch <= 57
}

function int http_len(str text_value) {
    return string_length(text_value)
}

function bool http_eq(str left, str right) {
    return string_equals(left, right) != 0
}

function bool http_is_empty(str text_value) {
    return string_length(text_value) == 0
}

function str http_clone(str text_value) {
    if text_value == 0 {
        return http_empty_text()
    }
    return string_substring(text_value, 0, string_length(text_value))
}

function str http_slice(str text_value, int start_idx, int slice_len) {
    return string_substring(text_value, start_idx, slice_len)
}

function str http_prefix(str text_value, int slice_len) {
    return string_substring(text_value, 0, slice_len)
}

function str http_join2(str left, str right) {
    return string_append(left, right)
}

function str http_join3(str a, str b, str c) {
    let ab = string_append(a, b)
    let abc = string_append(ab, c)
    free(ab)
    return abc
}

function str http_join4(str a, str b, str c, str d) {
    let ab = string_append(a, b)
    let abc = string_append(ab, c)
    let abcd = string_append(abc, d)
    free(ab)
    free(abc)
    return abcd
}

function int http_hex_digit(int ch) {
    if ch >= 48 and ch <= 57 {
        return ch - 48
    }
    if ch >= 65 and ch <= 70 {
        return ch - 55
    }
    if ch >= 97 and ch <= 102 {
        return ch - 87
    }
    return -1
}

function int http_hex_char(int nibble) {
    if nibble < 10 {
        return 48 + nibble
    }
    return 65 + nibble - 10
}

// percent-encode for URLs and query values: unreserved (alnum -_.~) pass through
function int http_url_encoded_len(str text_value) {
    if text_value == 0 {
        return 0
    }
    let len = string_length(text_value)
    let p = text_value as ptr
    var total = 0
    var i = 0
    while i < len {
        let ch = mem.read8(p + i)
        let unreserved = (ch >= 48 and ch <= 57) or (ch >= 65 and ch <= 90) or
                         (ch >= 97 and ch <= 122) or ch == 45 or ch == 46 or
                         ch == 95 or ch == 126
        if unreserved {
            total++
        } else {
            total += 3
        }
        i++
    }
    return total
}

// write the percent-encoded form of text_value at dst+off, return the new offset
function int http_url_encode_into(ptr dst, int off, str text_value) {
    if text_value == 0 {
        return off
    }
    let len = string_length(text_value)
    let p = text_value as ptr
    var w = off
    var i = 0
    while i < len {
        let ch = mem.read8(p + i)
        let unreserved = (ch >= 48 and ch <= 57) or (ch >= 65 and ch <= 90) or
                         (ch >= 97 and ch <= 122) or ch == 45 or ch == 46 or
                         ch == 95 or ch == 126
        if unreserved {
            mem.write8(dst + w, ch)
            w++
        } else {
            mem.write8(dst + w, 37)
            mem.write8(dst + w + 1, http_hex_char((ch >> 4) & 15))
            mem.write8(dst + w + 2, http_hex_char(ch & 15))
            w += 3
        }
        i++
    }
    return w
}

function str http_url_encode(str text_value) {
    if text_value == 0 {
        return http_empty_text()
    }
    let need = http_url_encoded_len(text_value)
    let out = malloc(need + 1)
    if out == 0 {
        return http_empty_text()
    }
    let stop = http_url_encode_into(out, 0, text_value)
    mem.write8(out + stop, 0)
    let result = make_string(out)
    free(out)
    return result
}

// decode %XX and treat '+' as space
function str http_url_decode(str text_value) {
    if text_value == 0 {
        return http_empty_text()
    }
    let len = string_length(text_value)
    if len == 0 {
        return http_empty_text()
    }
    let p = text_value as ptr
    let out = malloc(len + 1)
    if out == 0 {
        return http_empty_text()
    }
    var write_idx = 0
    var i = 0
    while i < len {
        let ch = mem.read8(p + i)
        if ch == 37 and i + 2 < len {
            let hi = http_hex_digit(mem.read8(p + i + 1))
            let lo = http_hex_digit(mem.read8(p + i + 2))
            if hi >= 0 and lo >= 0 {
                mem.write8(out + write_idx, hi * 16 + lo)
                write_idx++
                i += 3
                continue
            }
        }
        if ch == 43 {
            mem.write8(out + write_idx, 32)
            write_idx++
            i++
            continue
        }
        mem.write8(out + write_idx, ch)
        write_idx++
        i++
    }
    mem.write8(out + write_idx, 0)
    let result = make_string(out)
    free(out)
    return result
}

function int http_find(str text_value, str needle) {
    let text_len_val = string_length(text_value)
    let needle_len = string_length(needle)
    if needle_len == 0 {
        return 0
    }
    if needle_len > text_len_val {
        return -1
    }

    let hay = text_value as ptr
    let ndl = needle as ptr
    let first = mem.read8(ndl)
    let limit = text_len_val - needle_len
    var i = 0
    while i <= limit {
        if mem.read8(hay + i) == first {
            if needle_len == 1 or memcmp(hay + i + 1, ndl + 1, needle_len - 1) == 0 {
                return i
            }
        }
        i++
    }
    return -1
}

function int http_rfind_char(str text_value, int ch) {
    let p = text_value as ptr
    let target = ch & 255
    var i = string_length(text_value) - 1
    while i >= 0 {
        if mem.read8(p + i) == target {
            return i
        }
        i--
    }
    return -1
}

// Lowercase copy of a string. Heap string (caller frees).
function str http_lower_copy(str text_value) {
    if text_value == 0 {
        return http_empty_text()
    }
    let len = string_length(text_value)
    let out = mem.make_zero(len + 1)
    if out == 0 {
        return http_empty_text()
    }
    let p = text_value as ptr
    var i = 0
    while i < len {
        mem.write8(out + i, http_ascii_lower(mem.read8(p + i)))
        i++
    }
    mem.write8(out + len, 0)
    let result = make_string(out)
    free(out)
    return result
}

function bool http_starts_with(str text_value, str prefix) {
    if text_value == 0 or prefix == 0 {
        return false
    }
    let plen = string_length(prefix)
    if plen == 0 {
        return true
    }
    if string_length(text_value) < plen {
        return false
    }
    return memcmp(text_value as ptr, prefix as ptr, plen) == 0
}

// Trim leading and trailing spaces/tabs. Heap string (caller frees).
function str http_trim(str text_value) {
    if text_value == 0 {
        return http_empty_text()
    }
    let len = string_length(text_value)
    let p = text_value as ptr
    var start = 0
    while start < len and (mem.read8(p + start) == 32 or mem.read8(p + start) == 9) {
        start++
    }
    var stop = len
    while stop > start and (mem.read8(p + stop - 1) == 32 or mem.read8(p + stop - 1) == 9) {
        stop--
    }
    if stop <= start {
        return http_empty_text()
    }
    return string_substring(text_value, start, stop - start)
}

function HttpUrl http_url_new() {
    let parsed = malloc(32) as HttpUrl
    if parsed == 0 {
        return 0 as HttpUrl
    }
    parsed.secure = 1
    parsed.port = 443
    parsed.host = 0 as str
    parsed.path = 0 as str
    return parsed
}

function void http_url_free(HttpUrl parsed) {
    if parsed == 0 {
        return
    }
    if parsed.host != 0 {
        free(parsed.host)
    }
    if parsed.path != 0 {
        free(parsed.path)
    }
    free(parsed)
}

// Response constructors take ownership of the header/body buffers they are
// given (http_request_send passes freshly allocated ones). body_text and
// raw_headers must be heap-owned (or 0); pass a literal and the later
// http_response_free would hand a PE image pointer to HeapFree.
function HttpResponse http_response_new(int status, str body_text) {
    let response = malloc(40) as HttpResponse
    if response == 0 {
        if body_text != 0 {
            free(body_text)
        }
        return 0 as HttpResponse
    }
    response.status = status
    response.body = body_text
    response.raw_headers = 0 as str
    response.body_bytes = 0
    response.body_len = 0
    return response
}

function HttpResponse http_response_new_full(int status, str body_text, str raw_headers) {
    let response = malloc(40) as HttpResponse
    if response == 0 {
        if body_text != 0 {
            free(body_text)
        }
        if raw_headers != 0 {
            free(raw_headers)
        }
        return 0 as HttpResponse
    }
    response.status = status
    response.body = body_text
    response.raw_headers = raw_headers
    response.body_bytes = 0
    response.body_len = 0
    return response
}

// like http_response_new_full but also carries a binary-safe body buffer.
// body_bytes keeps the exact bytes (including embedded NULs) and body_len its
// length; body_text is a null-terminated view for convenience.
function HttpResponse http_response_new_binary(int status, ptr body_bytes, int body_len, str raw_headers) {
    let response = malloc(40) as HttpResponse
    if response == 0 {
        if raw_headers != 0 {
            free(raw_headers)
        }
        return 0 as HttpResponse
    }
    response.status = status
    response.raw_headers = raw_headers
    response.body_bytes = body_bytes
    response.body_len = body_len
    if body_bytes != 0 {
        response.body = make_string(body_bytes)
    } else {
        response.body = http_empty_text()
    }
    return response
}

function HttpWideParts http_wide_parts_new() {
    let parts = malloc(32) as HttpWideParts
    if parts == 0 {
        return 0 as HttpWideParts
    }
    parts.user_agent_w = 0
    parts.method_w = 0
    parts.host_w = 0
    parts.path_w = 0
    return parts
}

function void http_wide_parts_free(HttpWideParts parts) {
    if parts == 0 {
        return
    }
    if parts.user_agent_w != 0 {
        free(parts.user_agent_w)
    }
    if parts.method_w != 0 {
        free(parts.method_w)
    }
    if parts.host_w != 0 {
        free(parts.host_w)
    }
    if parts.path_w != 0 {
        free(parts.path_w)
    }
    free(parts)
}

function HttpResponse http_fail_response() {
    return http_response_new(0, http_empty_text())
}

function void http_response_free(HttpResponse response) {
    if response == 0 {
        return
    }
    if response.body != 0 {
        free(response.body)
    }
    if response.raw_headers != 0 {
        free(response.raw_headers)
    }
    if response.body_bytes != 0 {
        free(response.body_bytes)
    }
    free(response)
}

function bool http_ok(HttpResponse response) {
    if response == 0 {
        return false
    }
    return response.status >= 200 and response.status < 300
}

function int http_parse_port(str text_value) {
    let len = http_len(text_value)
    if len <= 0 or len > 5 {
        return -1
    }

    let p = text_value as ptr
    var value = 0
    var i = 0
    while i < len {
        let ch = mem.read8(p + i)
        if !http_is_digit(ch) {
            return -1
        }
        value = value * 10 + (ch - 48)
        i++
    }
    if value <= 0 or value > 65535 {
        return -1
    }
    return value
}

function ptr http_utf16z(str text_value) {
    if text_value == 0 {
        return 0
    }
    let len = string_length(text_value)
    let out = mem.make_zero((len + 1) * 2)
    if out == 0 {
        return 0
    }

    let p = text_value as ptr
    var i = 0
    while i < len {
        mem.write16(out + i * 2, mem.read8(p + i))
        i++
    }
    return out
}

function ptr http_url_host_utf16(HttpUrl parsed) {
    if parsed == 0 or parsed.host == 0 {
        return 0
    }
    return http_utf16z(parsed.host)
}

function ptr http_url_path_utf16(HttpUrl parsed) {
    if parsed == 0 or parsed.path == 0 {
        return 0
    }
    return http_utf16z(parsed.path)
}

function ptr http_open_session(ptr open_fn, ptr set_timeouts_fn) {
    let user_agent_w = http_utf16z("Sable/WinHTTP")
    if user_agent_w == 0 {
        return 0
    }

    let winhttp_open = open_fn as WinHttpOpenFn
    let session = winhttp_open(user_agent_w, 1, 0, 0, 0)
    free(user_agent_w)
    if session != 0 and set_timeouts_fn != 0 {
        let winhttp_set_timeouts = set_timeouts_fn as WinHttpSetTimeoutsFn
        winhttp_set_timeouts(session, 5000, 5000, 5000, 5000)
    }
    return session
}

function str http_bytes_to_text(ptr bytes, int len) {
    let copy = mem.make_zero(len + 1)
    if copy == 0 {
        return http_empty_text()
    }
    if len > 0 and bytes != 0 {
        memcpy(copy, bytes, len)
    }
    let out = make_string(copy)
    free(copy)
    return out
}

function str http_take_path(str url, int start_idx, int stop_idx) {
    if start_idx >= stop_idx {
        return http_clone("/")
    }

    let p = url as ptr
    let first = mem.read8(p + start_idx)
    if first == 47 {
        return http_slice(url, start_idx, stop_idx - start_idx)
    }

    let suffix = http_slice(url, start_idx, stop_idx - start_idx)
    let out = http_join2("/", suffix)
    free(suffix)
    return out
}

function HttpUrl http_parse_url(str url) {
    if url == 0 {
        return 0 as HttpUrl
    }
    let parsed = http_url_new()
    if parsed == 0 {
        return 0 as HttpUrl
    }

    let url_len = http_len(url)
    let p = url as ptr
    var start = 0

    if url_len >= 8 and memcmp(p, "https://" as ptr, 8) == 0 {
        parsed.secure = 1
        parsed.port = 443
        start = 8
    } else if url_len >= 7 and memcmp(p, "http://" as ptr, 7) == 0 {
        parsed.secure = 0
        parsed.port = 80
        start = 7
    }

    if start >= url_len {
        http_url_free(parsed)
        return 0 as HttpUrl
    }

    var host_end = start
    while host_end < url_len {
        let ch = mem.read8(p + host_end)
        if ch == 47 or ch == 63 {
            break
        }
        host_end++
    }

    if host_end <= start {
        http_url_free(parsed)
        return 0 as HttpUrl
    }

    // Optional host:port parsing
    var host_stop = host_end
    var colon_idx = start
    while colon_idx < host_end {
        if mem.read8(p + colon_idx) == 58 {
            let port_str = string_substring(url, colon_idx + 1, host_end - colon_idx - 1)
            let parsed_port = http_parse_port(port_str)
            free(port_str)
            if parsed_port <= 0 {
                http_url_free(parsed)
                return 0 as HttpUrl
            }
            parsed.port = parsed_port
            host_stop = colon_idx
            break
        }
        colon_idx++
    }

    if host_stop <= start {
        http_url_free(parsed)
        return 0 as HttpUrl
    }

    parsed.host = string_substring(url, start, host_stop - start)
    if parsed.host == 0 or string_length(parsed.host) == 0 {
        http_url_free(parsed)
        return 0 as HttpUrl
    }

    parsed.path = http_take_path(url, host_end, url_len)
    if parsed.path == 0 {
        http_url_free(parsed)
        return 0 as HttpUrl
    }

    return parsed
}

function void http_close_if(ptr close_fn, ptr handle_value) {
    if handle_value != 0 and close_fn != 0 {
        let winhttp_close = close_fn as WinHttpCloseHandleFn
        winhttp_close(handle_value)
    }
}

// ============================================================================
// Client configuration (proxy, TLS, HTTP/2, timeouts, cookies, streaming)
// ============================================================================

function HttpConfig http_config_new() {
    let cfg = mem.make_zero(HttpConfigSize.ConfigBytes) as HttpConfig
    if cfg == 0 {
        return 0 as HttpConfig
    }
    cfg.proxy = 0 as str
    cfg.proxy_bypass = 0 as str
    cfg.user_agent = 0 as str
    cfg.cookie_jar = 0
    cfg.timeout_ms = 30000
    cfg.http_version = HttpVersion.Auto
    cfg.tls = HttpTlsVerify.VerifyDefault
    cfg.follow_redirects = 1
    cfg.proxy_auth_user = 0 as str
    cfg.proxy_auth_pass = 0 as str
    cfg.enable_cookies = 0
    cfg.stream_sink = 0
    cfg.stream_context = 0
    return cfg
}

// Config strings are borrowed, so freeing a config only releases the struct.
function void http_config_free(HttpConfig cfg) {
    if cfg == 0 {
        return
    }
    free(cfg)
}

function void http_config_set_proxy(HttpConfig cfg, str proxy, str bypass) {
    if cfg == 0 {
        return
    }
    cfg.proxy = proxy
    cfg.proxy_bypass = bypass
}

function void http_config_set_proxy_auth(HttpConfig cfg, str user, str pass) {
    if cfg == 0 {
        return
    }
    cfg.proxy_auth_user = user
    cfg.proxy_auth_pass = pass
}

function void http_config_set_tls(HttpConfig cfg, int verify_level) {
    if cfg == 0 {
        return
    }
    cfg.tls = verify_level
}

function void http_config_set_http_version(HttpConfig cfg, int version) {
    if cfg == 0 {
        return
    }
    cfg.http_version = version
}

function void http_config_set_timeout(HttpConfig cfg, int ms) {
    if cfg == 0 {
        return
    }
    cfg.timeout_ms = ms
}

function void http_config_set_user_agent(HttpConfig cfg, str agent) {
    if cfg == 0 {
        return
    }
    cfg.user_agent = agent
}

function void http_config_set_follow_redirects(HttpConfig cfg, bool follow) {
    if cfg == 0 {
        return
    }
    if follow {
        cfg.follow_redirects = 1
    } else {
        cfg.follow_redirects = 0
    }
}

function void http_config_set_cookie_jar(HttpConfig cfg, HttpCookieJar jar) {
    if cfg == 0 {
        return
    }
    cfg.cookie_jar = jar
    cfg.enable_cookies = 1
}

// Attach a streaming sink. The sink receives each body chunk as it arrives and
// the response body is left empty (bytes go to the sink instead of memory).
// `context` is an opaque pointer handed to every sink call (curl userdata).
function void http_config_set_sink(HttpConfig cfg, HttpSinkFn sink) {
    if cfg == 0 {
        return
    }
    cfg.stream_sink = sink
}

function void http_config_set_sink_ctx(HttpConfig cfg, HttpSinkFn sink, ptr context) {
    if cfg == 0 {
        return
    }
    cfg.stream_sink = sink
    cfg.stream_context = context
}

// Apply the config to a session/request pair. set_option_fn may be 0, in which
// case the option calls are skipped. Returns true when every attempted option
// call succeeded (a call can legitimately fail on older Windows for options it
// does not know).
function bool http_apply_config_to_session(HttpConfig cfg, ptr session, ptr set_option_fn) {
    if cfg == 0 or session == 0 or set_option_fn == 0 {
        return true
    }
    let set_fn = set_option_fn as WinHttpSetOptionFn
    let scratch = mem.make_zero(4)
    if scratch == 0 {
        return false
    }
    var all_ok = true

    // TLS protocol floor: disable SSL2/SSL3, allow TLS 1.0-1.3.
    mem.write32(scratch, HttpSecureProtocol.Tls10 + HttpSecureProtocol.Tls11 + HttpSecureProtocol.Tls12 + HttpSecureProtocol.Tls13)
    if set_fn(session, HttpOption.SecureProtocols, scratch, 4) == 0 {
        all_ok = false
    }

    // Proxy: WINHTTP_PROXY_INFO { dwAccessType, lpszProxy, lpszProxyBypass }
    if cfg.proxy != 0 and string_length(cfg.proxy) > 0 {
        let info = mem.make_zero(24)
        if info == 0 {
            free(scratch)
            return false
        }
        mem.write32(info, HttpProxyAccess.NamedProxy)
        mem.write64(info + 8, http_utf16z(cfg.proxy) as int)
        if cfg.proxy_bypass != 0 and string_length(cfg.proxy_bypass) > 0 {
            mem.write64(info + 16, http_utf16z(cfg.proxy_bypass) as int)
        }
        if set_fn(session, HttpOption.Proxy, info, 24) == 0 {
            all_ok = false
        }
        let p1 = mem.read64(info + 8)
        let p2 = mem.read64(info + 16)
        if p1 != 0 { free(p1 as ptr) }
        if p2 != 0 { free(p2 as ptr) }
        free(info)
    }

    free(scratch)
    return all_ok
}

function bool http_apply_config_to_request(HttpConfig cfg, ptr request, ptr set_option_fn) {
    if cfg == 0 or request == 0 {
        return true
    }
    var all_ok = true

    if set_option_fn != 0 {
        let set_fn = set_option_fn as WinHttpSetOptionFn

        // Redirect policy (option 88): 0 = never, 2 = always.
        let policy = mem.make_zero(4)
        if policy != 0 {
            if cfg.follow_redirects != 0 {
                mem.write32(policy, HttpRedirectPolicy.Always)
            } else {
                mem.write32(policy, HttpRedirectPolicy.Never)
            }
            if set_fn(request, HttpOption.RedirectPolicy, policy, 4) == 0 {
                all_ok = false
            }
            free(policy)
        }

        // HTTP/2 opt-in (option 133). Per MSDN this must be set on the request
        // handle after WinHttpOpenRequest and before WinHttpSendRequest.
        if cfg.http_version == HttpVersion.Http2 {
            let proto = mem.make_zero(4)
            if proto != 0 {
                mem.write32(proto, HttpProtocolFlag.Http2)
                if set_fn(request, HttpOption.EnableHttpProtocol, proto, 4) == 0 {
                    all_ok = false
                }
                free(proto)
            }
        } else if cfg.http_version == HttpVersion.Http11 {
            // explicitly forbid h2-over-tcp so the request stays on HTTP/1.1
            let dis = mem.make_zero(4)
            if dis != 0 {
                mem.write32(dis, HttpDisableFeature.Http2OverTcp)
                if set_fn(request, HttpOption.DisableFeature, dis, 4) == 0 {
                    all_ok = false
                }
                free(dis)
            }
        }

        // TLS verification relaxation (option 31, WINHTTP_OPTION_SECURITY_FLAGS).
        if cfg.tls != HttpTlsVerify.VerifyDefault {
            var flags = 0
            if cfg.tls == HttpTlsVerify.IgnoreCertCnFailure or cfg.tls == HttpTlsVerify.IgnoreAll {
                flags = flags + HttpSecurityFlag.CertCnInvalid
            }
            if cfg.tls == HttpTlsVerify.IgnoreCertDateFailure or cfg.tls == HttpTlsVerify.IgnoreAll {
                flags = flags + HttpSecurityFlag.CertDateInvalid
            }
            let sec = mem.make_zero(4)
            if sec != 0 {
                mem.write32(sec, flags)
                if set_fn(request, 31, sec, 4) == 0 {
                    all_ok = false
                }
                free(sec)
            }
        }
    }
    return all_ok
}

// ============================================================================
// Cookie jar
// ============================================================================

function HttpCookieJar http_cookie_jar_new() {
    let jar = mem.make_zero(HttpCookieJarSize.JarBytes) as HttpCookieJar
    if jar == 0 {
        return 0 as HttpCookieJar
    }
    jar.cap = 8
    jar.count = 0
    jar.names = mem.make_zero(jar.cap * 8)
    jar.values = mem.make_zero(jar.cap * 8)
    jar.domains = mem.make_zero(jar.cap * 8)
    jar.paths = mem.make_zero(jar.cap * 8)
    jar.secure = mem.make_zero(jar.cap * 8)
    if jar.names == 0 or jar.values == 0 or jar.domains == 0 or jar.paths == 0 or jar.secure == 0 {
        http_cookie_jar_free(jar)
        return 0 as HttpCookieJar
    }
    return jar
}

function void http_cookie_jar_free(HttpCookieJar jar) {
    if jar == 0 {
        return
    }
    var i = 0
    while i < jar.count {
        let nm = mem.read(jar.names + i * 8) as str
        let vl = mem.read(jar.values + i * 8) as str
        let dm = mem.read(jar.domains + i * 8) as str
        let pt = mem.read(jar.paths + i * 8) as str
        if nm != 0 { free(nm) }
        if vl != 0 { free(vl) }
        if dm != 0 { free(dm) }
        if pt != 0 { free(pt) }
        i++
    }
    if jar.names != 0 { free(jar.names) }
    if jar.values != 0 { free(jar.values) }
    if jar.domains != 0 { free(jar.domains) }
    if jar.paths != 0 { free(jar.paths) }
    if jar.secure != 0 { free(jar.secure) }
    free(jar)
}

// Grow the parallel arrays to hold one more cookie. Keeps the layout invariant:
// all five arrays always have `cap` slots.
function bool http_cookie_grow(HttpCookieJar jar) {
    if jar.count < jar.cap {
        return true
    }
    let new_cap = jar.cap * 2
    let nn = mem.make_zero(new_cap * 8)
    let nv = mem.make_zero(new_cap * 8)
    let nd = mem.make_zero(new_cap * 8)
    let np = mem.make_zero(new_cap * 8)
    let ns = mem.make_zero(new_cap * 8)
    if nn == 0 or nv == 0 or nd == 0 or np == 0 or ns == 0 {
        if nn != 0 { free(nn) }
        if nv != 0 { free(nv) }
        if nd != 0 { free(nd) }
        if np != 0 { free(np) }
        if ns != 0 { free(ns) }
        return false
    }
    if jar.count > 0 {
        memcpy(nn, jar.names, jar.count * 8)
        memcpy(nv, jar.values, jar.count * 8)
        memcpy(nd, jar.domains, jar.count * 8)
        memcpy(np, jar.paths, jar.count * 8)
        memcpy(ns, jar.secure, jar.count * 8)
    }
    free(jar.names)  free(jar.values)  free(jar.domains)  free(jar.paths)  free(jar.secure)
    jar.names = nn  jar.values = nv  jar.domains = nd  jar.paths = np  jar.secure = ns
    jar.cap = new_cap
    return true
}

// Replace any existing cookie with the same name+domain+path, else append.
function void http_cookie_set(HttpCookieJar jar, str domain, str path, str name, str value, bool secure) {
    if jar == 0 or name == 0 or string_length(name) == 0 {
        return
    }
    var i = 0
    while i < jar.count {
        let nm = mem.read(jar.names + i * 8) as str
        let dm = mem.read(jar.domains + i * 8) as str
        let pt = mem.read(jar.paths + i * 8) as str
        if http_eq(nm, name) and http_eq(dm, domain) and http_eq(pt, path) {
            let old = mem.read(jar.values + i * 8) as str
            if old != 0 { free(old) }
            mem.write(jar.values + i * 8, http_dup(value) as int)
            return
        }
        i++
    }
    if !http_cookie_grow(jar) {
        return
    }
    let idx = jar.count
    mem.write(jar.names + idx * 8, http_dup(name) as int)
    mem.write(jar.values + idx * 8, http_dup(value) as int)
    mem.write(jar.domains + idx * 8, http_dup(domain) as int)
    mem.write(jar.paths + idx * 8, http_dup(path) as int)
    mem.write(jar.secure + idx * 8, secure as int)
    jar.count = idx + 1
}

function str http_cookie_get(HttpCookieJar jar, str domain, str name) {
    if jar == 0 or name == 0 {
        return 0 as str
    }
    var i = 0
    while i < jar.count {
        let nm = mem.read(jar.names + i * 8) as str
        let dm = mem.read(jar.domains + i * 8) as str
        if http_eq(nm, name) and http_eq(dm, domain) {
            let vl = mem.read(jar.values + i * 8) as str
            if vl != 0 {
                return http_dup(vl)
            }
        }
        i++
    }
    return 0 as str
}

// Build a "Cookie: n1=v1; n2=v2" header value for `domain`. Heap string
// (caller frees) or 0 when the jar has nothing for that host.
function str http_cookie_header_for(HttpCookieJar jar, str domain) {
    if jar == 0 or domain == 0 or jar.count == 0 {
        return 0 as str
    }
    var out = http_empty_text()
    var matched = 0
    var i = 0
    while i < jar.count {
        let nm = mem.read(jar.names + i * 8) as str
        let dm = mem.read(jar.domains + i * 8) as str
        let vl = mem.read(jar.values + i * 8) as str
        if http_eq(dm, domain) and nm != 0 {
            var piece = http_join2(nm, "=")
            let with_val = http_join2(piece, vl)
            free(piece)
            var next = ""
            if matched > 0 {
                next = http_join2(out, "; ")
                free(out)
            } else {
                next = out
            }
            let final = http_join2(next, with_val)
            free(next)
            free(with_val)
            out = final
            matched++
        }
        i++
    }
    if matched == 0 {
        free(out)
        return 0 as str
    }
    return out
}

// Parse one "Set-Cookie: name=value; Path=/; Domain=...; Secure; ..." line into
// the jar. `default_domain` is the request host, used when the cookie omits
// Domain. Returns true when a cookie was stored.
function bool http_cookie_absorb_line(HttpCookieJar jar, str default_domain, str line) {
    if jar == 0 or line == 0 {
        return false
    }
    let eq = http_find(line, "=")
    if eq <= 0 {
        return false
    }
    let name = string_substring(line, 0, eq)
    // value runs to the first ';' or end
    let semi = http_find(line, ";")
    var value = 0 as str
    if semi > eq {
        value = string_substring(line, eq + 1, semi - eq - 1)
    } else {
        value = string_substring(line, eq + 1, string_length(line) - eq - 1)
    }

    var domain = http_dup(default_domain)
    var path = http_clone("/")
    var secure = false

    // scan the attribute list
    var rest = semi
    while rest > 0 and rest < string_length(line) {
        var attr_start = rest + 1
        // skip spaces
        while attr_start < string_length(line) and mem.read8((line as ptr) + attr_start) == 32 {
            attr_start++
        }
        var attr_end = attr_start
        while attr_end < string_length(line) and mem.read8((line as ptr) + attr_end) != 59 {
            attr_end++
        }
        let attr = string_substring(line, attr_start, attr_end - attr_start)
        let alot_lower = http_lower_copy(attr)
        if http_starts_with(alot_lower, "domain=") {
            free(domain)
            domain = string_substring(attr, 7, string_length(attr) - 7)
        } else if http_starts_with(alot_lower, "path=") {
            free(path)
            path = string_substring(attr, 5, string_length(attr) - 5)
        } else if http_starts_with(alot_lower, "secure") {
            secure = true
        }
        free(alot_lower)
        free(attr)
        rest = attr_end
    }

    http_cookie_set(jar, domain, path, name, value, secure)
    free(name)  free(value)  free(domain)  free(path)
    return true
}

// Pull every Set-Cookie line out of a raw response header block and absorb the
// name=value pairs into the jar (domain defaults to `host`).
function int http_cookie_absorb_headers(HttpCookieJar jar, str host, str raw_headers) {
    if jar == 0 or raw_headers == 0 {
        return 0
    }
    var absorbed = 0
    let len = string_length(raw_headers)
    let bp = raw_headers as ptr
    var line_start = 0
    while line_start < len {
        var line_end = line_start
        while line_end < len and mem.read8(bp + line_end) != 13 {
            line_end++
        }
        let line_len = line_end - line_start
        if line_len > 12 {
            let prefix = string_substring(raw_headers, line_start, 11)
            let lower = http_lower_copy(prefix)
            if http_eq(lower, "set-cookie:") {
                let value = string_substring(raw_headers, line_start + 11, line_len - 11)
                let trimmed = http_trim(value)
                free(value)
                if http_cookie_absorb_line(jar, host, trimmed) {
                    absorbed++
                }
                free(trimmed)
            }
            free(prefix)
            free(lower)
        }
        line_start = line_end
        if line_start < len and mem.read8(bp + line_start) == 13 { line_start++ }
        if line_start < len and mem.read8(bp + line_start) == 10 { line_start++ }
    }
    return absorbed
}

function int http_cookie_count(HttpCookieJar jar) {
    if jar == 0 {
        return 0
    }
    return jar.count
}

function int http_query_status(ptr request_handle, ptr query_headers) {
    let status_ptr = mem.make_zero(8)
    let size_ptr = mem.make_zero(8)
    if status_ptr == 0 or size_ptr == 0 {
        if status_ptr != 0 { free(status_ptr) }
        if size_ptr != 0 { free(size_ptr) }
        return 0
    }

    mem.write32(size_ptr, 4)
    var status = 0
    let query_fn = query_headers as WinHttpQueryHeadersFn
    // WINHTTP_QUERY_STATUS_CODE (19) | WINHTTP_QUERY_FLAG_NUMBER (0x20000000)
    let ok = query_fn(request_handle, 19 + 536870912, 0, status_ptr, size_ptr, 0)
    if ok != 0 {
        status = mem.read32(status_ptr)
    }

    free(status_ptr)
    free(size_ptr)
    return status
}

// Read the full response body into a freshly allocated buffer.
// Returns the buffer pointer (caller frees) and writes the byte count to
// len_out. Keeps embedded NULs, so it is safe for binary payloads.
function ptr http_read_body_bytes(ptr request_handle, ptr query_data_available, ptr read_data, ptr len_out) {
    let available_ptr = mem.make_zero(8)
    let read_count_ptr = mem.make_zero(8)
    var cap = 4096
    var total_len = 0
    var buf = malloc(cap + 1)
    if available_ptr == 0 or read_count_ptr == 0 or buf == 0 {
        if available_ptr != 0 { free(available_ptr) }
        if read_count_ptr != 0 { free(read_count_ptr) }
        if buf != 0 { free(buf) }
        mem.write(len_out, 0)
        return 0
    }

    let query_avail_fn = query_data_available as WinHttpQueryDataAvailableFn
    let read_data_fn = read_data as WinHttpReadDataFn
    var failed = false

    while true {
        mem.write32(available_ptr, 0)
        if query_avail_fn(request_handle, available_ptr) == 0 {
            failed = true
            break
        }

        let available = mem.read32(available_ptr)
        if available <= 0 {
            break
        }

        if total_len + available + 1 > cap {
            var new_cap = cap
            while new_cap < total_len + available + 1 {
                new_cap = new_cap * 2
            }
            let next_buf = malloc(new_cap + 1)
            if next_buf == 0 {
                failed = true
                break
            }
            if total_len > 0 {
                memcpy(next_buf, buf, total_len)
            }
            free(buf)
            buf = next_buf
            cap = new_cap
        }

        mem.write32(read_count_ptr, 0)
        if read_data_fn(request_handle, buf + total_len, available, read_count_ptr) == 0 {
            failed = true
            break
        }

        let chunk_len = mem.read32(read_count_ptr)
        if chunk_len <= 0 {
            break
        }
        total_len = total_len + chunk_len
    }

    free(available_ptr)
    free(read_count_ptr)
    if failed {
        free(buf)
        mem.write(len_out, 0)
        return 0
    }
    mem.write8(buf + total_len, 0)
    mem.write(len_out, total_len)
    return buf
}

// Stream the response body through `sink` in chunks. Returns the total byte
// count delivered, or -1 on a transfer error. Nothing is buffered in memory
// beyond the read chunk, so this is safe for arbitrarily large bodies.
function int http_stream_body(ptr request_handle, ptr query_data_available, ptr read_data, HttpSinkFn sink, ptr context) {
    if sink == 0 {
        return -1
    }
    let available_ptr = mem.make_zero(8)
    let read_count_ptr = mem.make_zero(8)
    if available_ptr == 0 or read_count_ptr == 0 {
        if available_ptr != 0 { free(available_ptr) }
        if read_count_ptr != 0 { free(read_count_ptr) }
        return -1
    }
    let chunk = malloc(65536)
    if chunk == 0 {
        free(available_ptr)
        free(read_count_ptr)
        return -1
    }

    let query_avail_fn = query_data_available as WinHttpQueryDataAvailableFn
    let read_data_fn = read_data as WinHttpReadDataFn
    var total = 0
    var failed = false

    while true {
        mem.write32(available_ptr, 0)
        if query_avail_fn(request_handle, available_ptr) == 0 {
            failed = true
            break
        }
        let available = mem.read32(available_ptr)
        if available <= 0 {
            break
        }
        var want = available
        if want > 65536 {
            want = 65536
        }
        mem.write32(read_count_ptr, 0)
        if read_data_fn(request_handle, chunk, want, read_count_ptr) == 0 {
            failed = true
            break
        }
        let got = mem.read32(read_count_ptr)
        if got <= 0 {
            break
        }
        if sink(context, chunk, got) == 0 {
            failed = true
            break
        }
        total = total + got
    }

    free(chunk)
    free(available_ptr)
    free(read_count_ptr)
    if failed {
        return -1
    }
    return total
}

function str http_read_body(ptr request_handle, ptr query_data_available, ptr read_data) {
    let len_ptr = mem.make_zero(8)
    if len_ptr == 0 {
        return http_empty_text()
    }
    let buf = http_read_body_bytes(request_handle, query_data_available, read_data, len_ptr)
    free(len_ptr)
    if buf == 0 {
        return http_empty_text()
    }
    let out = make_string(buf)
    free(buf)
    return out
}

function HttpResponse http_fetch(str url) {
    let parsed = http_parse_url(url)
    if parsed == 0 {
        return http_fail_response()
    }

    let module_handle = load_library("winhttp.dll")
    if module_handle == 0 {
        http_url_free(parsed)
        return http_fail_response()
    }

    let open_fn = get_proc(module_handle, "WinHttpOpen")
    let connect_fn = get_proc(module_handle, "WinHttpConnect")
    let open_request_fn = get_proc(module_handle, "WinHttpOpenRequest")
    let send_request_fn = get_proc(module_handle, "WinHttpSendRequest")
    let receive_response_fn = get_proc(module_handle, "WinHttpReceiveResponse")
    let query_data_available_fn = get_proc(module_handle, "WinHttpQueryDataAvailable")
    let query_headers_fn = get_proc(module_handle, "WinHttpQueryHeaders")
    let read_data_fn = get_proc(module_handle, "WinHttpReadData")
    let set_timeouts_fn = get_proc(module_handle, "WinHttpSetTimeouts")
    let close_handle_fn = get_proc(module_handle, "WinHttpCloseHandle")

    if open_fn == 0 or connect_fn == 0 or open_request_fn == 0 or send_request_fn == 0 or
       receive_response_fn == 0 or query_data_available_fn == 0 or query_headers_fn == 0 or read_data_fn == 0 or
       set_timeouts_fn == 0 or close_handle_fn == 0 {
        http_url_free(parsed)
        return http_fail_response()
    }

    let host_w = http_url_host_utf16(parsed)
    let method_w = http_utf16z("GET")
    let path_w = http_url_path_utf16(parsed)
    if host_w == 0 or method_w == 0 or path_w == 0 {
        if host_w != 0 { free(host_w) }
        if method_w != 0 { free(method_w) }
        if path_w != 0 { free(path_w) }
        http_url_free(parsed)
        return http_fail_response()
    }

    let session = http_open_session(open_fn, set_timeouts_fn)
    if session == 0 {
        free(host_w)
        free(method_w)
        free(path_w)
        http_url_free(parsed)
        return http_fail_response()
    }

    let winhttp_connect = connect_fn as WinHttpConnectFn
    let connection = winhttp_connect(session, host_w, parsed.port, 0)
    free(host_w)
    if connection == 0 {
        free(method_w)
        free(path_w)
        http_close_if(close_handle_fn, session)
        http_url_free(parsed)
        return http_fail_response()
    }

    var request_flags = 0
    if parsed.secure != 0 {
        request_flags = 8388608
    }

    let winhttp_open_req = open_request_fn as WinHttpOpenRequestFn
    let request = winhttp_open_req(connection, method_w, path_w, 0, 0, 0, request_flags)
    free(method_w)
    free(path_w)
    http_url_free(parsed)

    if request == 0 {
        http_close_if(close_handle_fn, connection)
        http_close_if(close_handle_fn, session)
        return http_fail_response()
    }

    let winhttp_send = send_request_fn as WinHttpSendRequestFn
    let winhttp_recv = receive_response_fn as WinHttpReceiveResponseFn
    if winhttp_send(request, 0, 0, 0, 0, 0, 0) == 0 or winhttp_recv(request, 0) == 0 {
        http_close_if(close_handle_fn, request)
        http_close_if(close_handle_fn, connection)
        http_close_if(close_handle_fn, session)
        return http_fail_response()
    }

    let status = http_query_status(request, query_headers_fn)
    let raw_headers = http_query_raw_headers(request, query_headers_fn)
    let len_ptr = mem.make_zero(8)
    var body = 0
    var body_len = 0
    if len_ptr != 0 {
        body = http_read_body_bytes(request, query_data_available_fn, read_data_fn, len_ptr)
        body_len = mem.read(len_ptr)
        free(len_ptr)
    }

    http_close_if(close_handle_fn, request)
    http_close_if(close_handle_fn, connection)
    http_close_if(close_handle_fn, session)
    if body == 0 {
        return http_response_new_full(status, http_empty_text(), raw_headers)
    }
    return http_response_new_binary(status, body, body_len, raw_headers)
}

function int http_debug_fetch_stage(str url) {
    let response = http_fetch(url)
    if response == 0 {
        return 0
    }
    let status = response.status
    http_response_free(response)
    return status
}

function str http_get(str url) {
    let response = http_fetch(url)
    if response == 0 {
        return http_empty_text()
    }

    let body_text = response.body
    response.body = 0 as str
    if response.raw_headers != 0 {
        free(response.raw_headers)
    }
    if response.body_bytes != 0 {
        free(response.body_bytes)
    }
    free(response)
    if body_text == 0 {
        return http_empty_text()
    }
    return body_text
}

// ============================================================================
// Rich request builder (WinHTTP)
//
// http_request_new() returns a heap HttpRequest block. Setters copy their
// arguments, so callers keep ownership of anything they pass in. Send with
// http_request_send(), which returns an HttpResponse carrying status, body and
// the raw CRLF header block (queryable via http_response_header).
// ============================================================================

enum HttpRequestOffset {
    Method = 0,           // str
    Url = 8,              // str
    HeaderBuf = 16,       // ptr raw "Name: Value\r\n..." text
    HeaderLen = 24,       // int
    HeaderCap = 32,       // int
    Body = 40,            // ptr raw bytes
    BodyLen = 48,          // int
    ContentType = 56,     // str
    UserAgent = 64,       // str
    TimeoutMs = 72,       // int
    FollowRedirects = 80, // int (bool)
    Config = 88,          // ptr HttpConfig or 0 (borrowed)
}

enum HttpRequestSize { RequestBytes = 96 }

view HttpRequest {
    method: str @ HttpRequestOffset.Method
    url: str @ HttpRequestOffset.Url
    header_buf: ptr @ HttpRequestOffset.HeaderBuf
    header_len: int @ HttpRequestOffset.HeaderLen
    header_cap: int @ HttpRequestOffset.HeaderCap
    body: ptr @ HttpRequestOffset.Body
    body_len: int @ HttpRequestOffset.BodyLen
    content_type: str @ HttpRequestOffset.ContentType
    user_agent: str @ HttpRequestOffset.UserAgent
    timeout_ms: int @ HttpRequestOffset.TimeoutMs
    follow_redirects: int @ HttpRequestOffset.FollowRedirects
    config: ptr @ HttpRequestOffset.Config
}

function str http_dup(str text_value) {
    if text_value == 0 {
        return 0 as str
    }
    return string_substring(text_value, 0, string_length(text_value))
}

// Grow a heap buffer so it can hold `used + add_len + 1` bytes, copying
// existing bytes. Returns the (possibly reallocated) pointer.
function ptr http_buf_reserve(ptr buf, int used, int cap, int add_len) {
    var need = used + add_len
    if need + 1 <= cap {
        return buf
    }
    var new_cap = cap
    if new_cap < 16 {
        new_cap = 16
    }
    while new_cap < need + 1 {
        new_cap = new_cap * 2
    }
    let next = malloc(new_cap + 1)
    if next == 0 {
        return buf
    }
    if used > 0 {
        memcpy(next, buf, used)
    }
    free(buf)
    mem.write8(next + used, 0)
    return next
}

function int http_buf_new_cap(int used, int cap, int add_len) {
    var need = used + add_len
    if need + 1 <= cap {
        return cap
    }
    var new_cap = cap
    if new_cap < 16 {
        new_cap = 16
    }
    while new_cap < need + 1 {
        new_cap = new_cap * 2
    }
    return new_cap
}

function HttpRequest http_request_new(str method, str url) {
    let req = mem.make_zero(HttpRequestSize.RequestBytes) as HttpRequest
    if req == 0 {
        return 0 as HttpRequest
    }
    req.method = http_dup(method)
    req.url = http_dup(url)
    req.header_buf = malloc(64)
    req.header_len = 0
    req.header_cap = 64
    req.body = 0
    req.body_len = 0
    req.content_type = 0 as str
    req.user_agent = 0 as str
    req.timeout_ms = 30000
    req.follow_redirects = 1
    req.config = 0
    if req.header_buf != 0 {
        mem.write8(req.header_buf, 0)
    }
    return req
}

function void http_request_header(HttpRequest req, str name, str value) {
    if req == 0 or req.header_buf == 0 {
        return
    }
    let line = http_join4(name, ": ", value, "\r\n")
    let line_len = string_length(line)
    let new_cap = http_buf_new_cap(req.header_len, req.header_cap, line_len)
    let grown = http_buf_reserve(req.header_buf, req.header_len, req.header_cap, line_len)
    req.header_buf = grown
    req.header_cap = new_cap
    if grown == 0 {
        free(line)
        return
    }
    memcpy(grown + req.header_len, line as ptr, line_len)
    req.header_len = req.header_len + line_len
    mem.write8(grown + req.header_len, 0)
    free(line)
}

function void http_request_body(HttpRequest req, ptr bytes, int len, str content_type) {
    if req == 0 {
        return
    }
    if req.body != 0 {
        free(req.body)
        req.body = 0
    }
    if bytes != 0 and len > 0 {
        req.body = mem.make_copy(bytes, len)
        req.body_len = len
    } else {
        req.body_len = 0
    }
    if req.content_type != 0 {
        free(req.content_type)
    }
    req.content_type = http_dup(content_type)
}

function void http_request_body_text(HttpRequest req, str text_value, str content_type) {
    if req == 0 {
        return
    }
    if text_value == 0 {
        http_request_body(req, 0, 0, content_type)
        return
    }
    http_request_body(req, text_value as ptr, string_length(text_value), content_type)
}

function void http_request_user_agent(HttpRequest req, str agent) {
    if req == 0 {
        return
    }
    if req.user_agent != 0 {
        free(req.user_agent)
    }
    req.user_agent = http_dup(agent)
}

function void http_request_timeout(HttpRequest req, int ms) {
    if req == 0 {
        return
    }
    req.timeout_ms = ms
}

function void http_request_follow_redirects(HttpRequest req, bool follow) {
    if req == 0 {
        return
    }
    if follow {
        req.follow_redirects = 1
    } else {
        req.follow_redirects = 0
    }
}

// Attach a client config (proxy, TLS, HTTP/2, cookies, streaming). Borrowed, not
// owned: the config must outlive the request. Passing 0 restores defaults.
function void http_request_set_config(HttpRequest req, HttpConfig cfg) {
    if req == 0 {
        return
    }
    req.config = cfg
}

function void http_request_free(HttpRequest req) {
    if req == 0 {
        return
    }
    if req.method != 0 {
        free(req.method)
    }
    if req.url != 0 {
        free(req.url)
    }
    if req.header_buf != 0 {
        free(req.header_buf)
    }
    if req.body != 0 {
        free(req.body)
    }
    if req.content_type != 0 {
        free(req.content_type)
    }
    if req.user_agent != 0 {
        free(req.user_agent)
    }
    free(req)
}

// ============================================================================
// Send / response
// ============================================================================

function str http_query_raw_headers(ptr request_handle, ptr query_headers) {
    let size_ptr = mem.make_zero(8)
    if size_ptr == 0 {
        return 0 as str
    }
    mem.write32(size_ptr, 0)
    let query_fn = query_headers as WinHttpQueryHeadersFn
    // WINHTTP_QUERY_RAW_HEADERS_CRLF = 22. The exported WinHttpQueryHeaders here
    // is the wide (UTF-16) variant, so the length it returns is a WCHAR count.
    var ok = query_fn(request_handle, 22, 0, 0, size_ptr, 0)
    let needed = mem.read32(size_ptr)
    if needed <= 0 {
        free(size_ptr)
        return 0 as str
    }
    let wide = malloc(needed * 2 + 2)
    if wide == 0 {
        free(size_ptr)
        return 0 as str
    }
    mem.write32(size_ptr, needed)
    ok = query_fn(request_handle, 22, 0, wide, size_ptr, 0)
    free(size_ptr)
    if ok == 0 {
        free(wide)
        return 0 as str
    }
    // downconvert UTF-16 -> ASCII (header text is ASCII/ISO-8859-1)
    let out = malloc(needed + 1)
    if out == 0 {
        free(wide)
        return 0 as str
    }
    var i = 0
    var w = 0
    while i < needed {
        let lo = mem.read8(wide + i * 2)
        let hi = mem.read8(wide + i * 2 + 1)
        if lo == 0 and hi == 0 {
            break
        }
        mem.write8(out + w, lo)
        w++
        i++
    }
    mem.write8(out + w, 0)
    let result = make_string(out)
    free(out)
    free(wide)
    return result
}

function HttpResponse http_request_send(HttpRequest req) {
    if req == 0 or req.url == 0 {
        return http_fail_response()
    }

    let parsed = http_parse_url(req.url)
    if parsed == 0 {
        return http_fail_response()
    }

    let module_handle = load_library("winhttp.dll")
    if module_handle == 0 {
        http_url_free(parsed)
        return http_fail_response()
    }

    let open_fn = get_proc(module_handle, "WinHttpOpen")
    let connect_fn = get_proc(module_handle, "WinHttpConnect")
    let open_request_fn = get_proc(module_handle, "WinHttpOpenRequest")
    let send_request_fn = get_proc(module_handle, "WinHttpSendRequest")
    let receive_response_fn = get_proc(module_handle, "WinHttpReceiveResponse")
    let query_data_available_fn = get_proc(module_handle, "WinHttpQueryDataAvailable")
    let query_headers_fn = get_proc(module_handle, "WinHttpQueryHeaders")
    let read_data_fn = get_proc(module_handle, "WinHttpReadData")
    let set_timeouts_fn = get_proc(module_handle, "WinHttpSetTimeouts")
    let close_handle_fn = get_proc(module_handle, "WinHttpCloseHandle")
    let set_option_fn = get_proc(module_handle, "WinHttpSetOption")

    if open_fn == 0 or connect_fn == 0 or open_request_fn == 0 or send_request_fn == 0 or
       receive_response_fn == 0 or query_data_available_fn == 0 or query_headers_fn == 0 or
       read_data_fn == 0 or set_timeouts_fn == 0 or close_handle_fn == 0 {
        http_url_free(parsed)
        return http_fail_response()
    }

    let host_w = http_url_host_utf16(parsed)
    let method_w = http_utf16z(req.method)
    let path_w = http_url_path_utf16(parsed)
    if host_w == 0 or method_w == 0 or path_w == 0 {
        if host_w != 0 { free(host_w) }
        if method_w != 0 { free(method_w) }
        if path_w != 0 { free(path_w) }
        http_url_free(parsed)
        return http_fail_response()
    }

    let session = http_open_session(open_fn, set_timeouts_fn)
    if session == 0 {
        free(host_w)
        free(method_w)
        free(path_w)
        http_url_free(parsed)
        return http_fail_response()
    }

    if req.timeout_ms > 0 {
        let winhttp_set_timeouts = set_timeouts_fn as WinHttpSetTimeoutsFn
        winhttp_set_timeouts(session, req.timeout_ms, req.timeout_ms, req.timeout_ms, req.timeout_ms)
    }

    // client config: TLS floor, proxy, and (below, per-request) redirect policy,
    // HTTP/2 opt-in and TLS verification relaxation.
    let cfg = req.config as HttpConfig
    if cfg != 0 {
        if cfg.timeout_ms > 0 {
            let winhttp_set_timeouts = set_timeouts_fn as WinHttpSetTimeoutsFn
            winhttp_set_timeouts(session, cfg.timeout_ms, cfg.timeout_ms, cfg.timeout_ms, cfg.timeout_ms)
        }
        http_apply_config_to_session(cfg, session, set_option_fn)
    } else {
        // WINHTTP_OPTION_REDIRECT_POLICY = 88; values: 0 = never,
        // 1 = disallow https->http, 2 = always follow. Default is 2.
        if set_option_fn != 0 {
            let policy = mem.make_zero(4)
            if policy != 0 {
                if req.follow_redirects != 0 {
                    mem.write32(policy, 2)
                } else {
                    mem.write32(policy, 0)
                }
                let winhttp_set_option = set_option_fn as WinHttpSetOptionFn
                winhttp_set_option(session, 88, policy, 4)
                free(policy)
            }
        }
    }

    let winhttp_connect = connect_fn as WinHttpConnectFn
    let connection = winhttp_connect(session, host_w, parsed.port, 0)
    free(host_w)
    if connection == 0 {
        free(method_w)
        free(path_w)
        http_close_if(close_handle_fn, session)
        http_url_free(parsed)
        return http_fail_response()
    }

    var request_flags = 0
    if parsed.secure != 0 {
        request_flags = 8388608 // WINHTTP_FLAG_SECURE
    }

    let winhttp_open_req = open_request_fn as WinHttpOpenRequestFn
    let request = winhttp_open_req(connection, method_w, path_w, 0, 0, 0, request_flags)
    free(method_w)
    free(path_w)

    if request == 0 {
        http_url_free(parsed)
        http_close_if(close_handle_fn, connection)
        http_close_if(close_handle_fn, session)
        return http_fail_response()
    }

    // per-request config: redirect policy, HTTP/2 opt-in, TLS verification
    if cfg != 0 {
        http_apply_config_to_request(cfg, request, set_option_fn)
    }

    // inject cookies for this host, when a jar is attached
    var cookie_hdr = 0 as str
    if cfg != 0 and cfg.enable_cookies != 0 and cfg.cookie_jar != 0 {
        cookie_hdr = http_cookie_header_for(cfg.cookie_jar as HttpCookieJar, parsed.host)
        if cookie_hdr != 0 and string_length(cookie_hdr) > 0 {
            http_request_header(req, "Cookie", cookie_hdr)
        }
        if cookie_hdr != 0 {
            free(cookie_hdr)
        }
    }

    http_url_free(parsed)

    // Build the full wide (UTF-16) header block: accumulated headers plus a
    // Content-Type line when a body type was set. WinHttpSendRequest takes this
    // as lpszHeaders with dwHeadersLength = -1 (0xFFFFFFFF, null-terminated).
    var headers_w = 0
    var headers_present = 0
    if req.header_len > 0 or (req.content_type != 0 and string_length(req.content_type) > 0) {
        var ct_line = ""
        if req.content_type != 0 and string_length(req.content_type) > 0 {
            ct_line = http_join4("Content-Type", ": ", req.content_type, "\r\n")
        }
        let block = string_append(req.header_buf as str, ct_line)
        if string_length(ct_line) > 0 {
            free(ct_line)
        }
        headers_w = http_utf16z(block)
        free(block)
        if headers_w != 0 {
            headers_present = 1
        }
    }

    let winhttp_send = send_request_fn as WinHttpSendRequestFn
    let winhttp_recv = receive_response_fn as WinHttpReceiveResponseFn

    var send_ok = 0
    if headers_present != 0 {
        if req.body != 0 and req.body_len > 0 {
            send_ok = winhttp_send(request, headers_w, 0 as int - 1, req.body, req.body_len, req.body_len, 0)
        } else {
            send_ok = winhttp_send(request, headers_w, 0 as int - 1, 0, 0, 0, 0)
        }
    } else {
        if req.body != 0 and req.body_len > 0 {
            send_ok = winhttp_send(request, 0, 0, req.body, req.body_len, req.body_len, 0)
        } else {
            send_ok = winhttp_send(request, 0, 0, 0, 0, 0, 0)
        }
    }
    if headers_w != 0 {
        free(headers_w)
    }

    if send_ok == 0 or winhttp_recv(request, 0) == 0 {
        http_close_if(close_handle_fn, request)
        http_close_if(close_handle_fn, connection)
        http_close_if(close_handle_fn, session)
        return http_fail_response()
    }

    let status = http_query_status(request, query_headers_fn)
    let raw_headers = http_query_raw_headers(request, query_headers_fn)

    // absorb any Set-Cookie lines into the attached jar
    if cfg != 0 and cfg.enable_cookies != 0 and cfg.cookie_jar != 0 and raw_headers != 0 {
        let host_parsed = http_parse_url(req.url)
        if host_parsed != 0 {
            http_cookie_absorb_headers(cfg.cookie_jar as HttpCookieJar, host_parsed.host, raw_headers)
            http_url_free(host_parsed)
        }
    }

    // streaming: hand the body to the sink and keep nothing in memory
    if cfg != 0 and cfg.stream_sink != 0 {
        let sink = cfg.stream_sink as HttpSinkFn
        let streamed = http_stream_body(request, query_data_available_fn, read_data_fn, sink, cfg.stream_context)
        http_close_if(close_handle_fn, request)
        http_close_if(close_handle_fn, connection)
        http_close_if(close_handle_fn, session)
        if streamed < 0 {
            let failed = http_response_new_full(status, http_empty_text(), raw_headers)
            return failed
        }
        return http_response_new_full(status, http_empty_text(), raw_headers)
    }

    let body_len_ptr = mem.make_zero(8)
    var body_bytes = 0
    var body_len = 0
    if body_len_ptr != 0 {
        body_bytes = http_read_body_bytes(request, query_data_available_fn, read_data_fn, body_len_ptr)
        body_len = mem.read(body_len_ptr)
        free(body_len_ptr)
    }

    http_close_if(close_handle_fn, request)
    http_close_if(close_handle_fn, connection)
    http_close_if(close_handle_fn, session)

    if body_bytes == 0 {
        return http_response_new_full(status, http_empty_text(), raw_headers)
    }
    return http_response_new_binary(status, body_bytes, body_len, raw_headers)
}

// ============================================================================
// Response header lookup (case-insensitive)
// ============================================================================

function int http_ascii_lower(int ch) {
    if ch >= 65 and ch <= 90 {
        return ch + 32
    }
    return ch
}

function bool http_header_name_eq(str block, int start, int name_len, str name) {
    if string_length(name) != name_len {
        return false
    }
    let bp = block as ptr
    let np = name as ptr
    var i = 0
    while i < name_len {
        if http_ascii_lower(mem.read8(bp + start + i)) != http_ascii_lower(mem.read8(np + i)) {
            return false
        }
        i++
    }
    return true
}

// find "name: value" inside a CRLF header block, return value with surrounding
// spaces trimmed. Result is a heap string (caller frees) or 0 when absent.
function str http_header_find(str block, str name) {
    if block == 0 or name == 0 {
        return 0 as str
    }
    let len = string_length(block)
    let name_len = string_length(name)
    if len == 0 or name_len == 0 {
        return 0 as str
    }
    let bp = block as ptr
    var line_start = 0
    while line_start < len {
        // find end of this line
        var line_end = line_start
        while line_end < len and mem.read8(bp + line_end) != 13 {
            line_end++
        }
        // does "name:" start this line?
        if line_end - line_start > name_len and
           http_header_name_eq(block, line_start, name_len, name) and
           mem.read8(bp + line_start + name_len) == 58 {
            var value_start = line_start + name_len + 1
            // skip leading spaces/tabs
            while value_start < line_end and (mem.read8(bp + value_start) == 32 or mem.read8(bp + value_start) == 9) {
                value_start++
            }
            var value_end = line_end
            while value_end > value_start and (mem.read8(bp + value_end - 1) == 32 or mem.read8(bp + value_end - 1) == 9) {
                value_end--
            }
            if value_end <= value_start {
                return http_empty_text()
            }
            return string_substring(block, value_start, value_end - value_start)
        }
        // advance past CRLF
        line_start = line_end
        if line_start < len and mem.read8(bp + line_start) == 13 {
            line_start++
        }
        if line_start < len and mem.read8(bp + line_start) == 10 {
            line_start++
        }
    }
    return 0 as str
}

function str http_response_header(HttpResponse response, str name) {
    if response == 0 or response.raw_headers == 0 {
        return 0 as str
    }
    return http_header_find(response.raw_headers, name)
}

function str http_response_content_type(HttpResponse response) {
    let ct = http_response_header(response, "Content-Type")
    if ct == 0 {
        return http_empty_text()
    }
    return ct
}

// ============================================================================
// Verb convenience helpers
// ============================================================================

function HttpResponse http_request(str method, str url) {
    let req = http_request_new(method, url)
    if req == 0 {
        return http_fail_response()
    }
    let response = http_request_send(req)
    http_request_free(req)
    return response
}

function HttpResponse http_post(str url, str content_type, str body_text) {
    let req = http_request_new("POST", url)
    if req == 0 {
        return http_fail_response()
    }
    http_request_body_text(req, body_text, content_type)
    let response = http_request_send(req)
    http_request_free(req)
    return response
}

function HttpResponse http_put(str url, str content_type, str body_text) {
    let req = http_request_new("PUT", url)
    if req == 0 {
        return http_fail_response()
    }
    http_request_body_text(req, body_text, content_type)
    let response = http_request_send(req)
    http_request_free(req)
    return response
}

function HttpResponse http_patch(str url, str content_type, str body_text) {
    let req = http_request_new("PATCH", url)
    if req == 0 {
        return http_fail_response()
    }
    http_request_body_text(req, body_text, content_type)
    let response = http_request_send(req)
    http_request_free(req)
    return response
}

function HttpResponse http_delete(str url) {
    return http_request("DELETE", url)
}

function HttpResponse http_head(str url) {
    return http_request("HEAD", url)
}

// build a query string from parallel key/value arrays; values are percent-encoded
function str http_build_query(ptr keys, ptr values, int count) {
    if count <= 0 {
        return http_empty_text()
    }
    // first pass: total length
    var total = 0
    var i = 0
    while i < count {
        let key = mem.read(keys + i * 8) as str
        let value = mem.read(values + i * 8) as str
        total += http_url_encoded_len(key) + 1 + http_url_encoded_len(value)
        if i < count - 1 {
            total += 1
        }
        i++
    }
    let out = malloc(total + 1)
    if out == 0 {
        return http_empty_text()
    }
    var w = 0
    i = 0
    while i < count {
        let key = mem.read(keys + i * 8) as str
        let value = mem.read(values + i * 8) as str
        w = http_url_encode_into(out, w, key)
        mem.write8(out + w, 61) // =
        w++
        w = http_url_encode_into(out, w, value)
        if i < count - 1 {
            mem.write8(out + w, 38) // &
            w++
        }
        i++
    }
    mem.write8(out + w, 0)
    let result = make_string(out)
    free(out)
    return result
}


// ============================================================================
// Additional request helpers: query appending, base64/basic auth, multipart
// ============================================================================

// append "?k=v" (or "&k=v" when the url already has a query) to a url.
// key and value are percent-encoded. Returns a new heap string.
function str http_url_with_query(str url, str key, str value) {
    if url == 0 {
        return http_empty_text()
    }
    var sep = "?"
    if http_find(url, "?") >= 0 {
        sep = "&"
    }
    let ek = http_url_encode(key)
    let ev = http_url_encode(value)
    let result = http_join4(url, sep, ek, http_join2("=", ev))
    free(ek)
    free(ev)
    return result
}

function str http_request_add_query(HttpRequest req, str key, str value) {
    if req == 0 or req.url == 0 {
        return 0 as str
    }
    let next_url = http_url_with_query(req.url, key, value)
    if next_url == 0 {
        return 0 as str
    }
    free(req.url)
    req.url = next_url
    return next_url
}

enum HttpBase64Chars { Alphabet = 0 }

function int http_base64_char(int index) {
    // standard alphabet: A-Z a-z 0-9 + /
    if index < 26 {
        return 65 + index
    }
    if index < 52 {
        return 97 + (index - 26)
    }
    if index < 62 {
        return 48 + (index - 52)
    }
    if index == 62 {
        return 43
    }
    return 47
}

// base64-encode raw bytes; returns a heap string (caller frees)
function str http_base64_encode(ptr bytes, int len) {
    if bytes == 0 or len <= 0 {
        return http_empty_text()
    }
    let groups = (len + 2) / 3
    let out = malloc(groups * 4 + 1)
    if out == 0 {
        return http_empty_text()
    }
    var w = 0
    var i = 0
    while i < len {
        let b0 = mem.read8(bytes + i)
        var b1 = 0
        var b2 = 0
        let have1 = i + 1 < len
        let have2 = i + 2 < len
        if have1 {
            b1 = mem.read8(bytes + i + 1)
        }
        if have2 {
            b2 = mem.read8(bytes + i + 2)
        }
        mem.write8(out + w, http_base64_char((b0 >> 2) & 63))
        mem.write8(out + w + 1, http_base64_char(((b0 & 3) << 4) | ((b1 >> 4) & 15)))
        if have1 {
            mem.write8(out + w + 2, http_base64_char(((b1 & 15) << 2) | ((b2 >> 6) & 3)))
        } else {
            mem.write8(out + w + 2, 61) // '='
        }
        if have2 {
            mem.write8(out + w + 3, http_base64_char(b2 & 63))
        } else {
            mem.write8(out + w + 3, 61) // '='
        }
        w += 4
        i += 3
    }
    mem.write8(out + w, 0)
    let result = make_string(out)
    free(out)
    return result
}

function str http_basic_auth(str username, str password) {
    let joined = http_join3(username, ":", password)
    let token = http_base64_encode(joined as ptr, string_length(joined))
    let header = http_join2("Basic ", token)
    free(joined)
    free(token)
    return header
}

// set an Authorization: Basic ... header from credentials
function void http_request_basic_auth(HttpRequest req, str username, str password) {
    if req == 0 {
        return
    }
    let value = http_basic_auth(username, password)
    http_request_header(req, "Authorization", value)
    free(value)
}

// build a multipart/form-data body with a single text field. Pair it with
// http_multipart_content_type(boundary) for the Content-Type header.
// Caller frees the returned body.
function str http_multipart_field(str field_name, str value, str boundary) {
    let part = http_join4("--", boundary, "\r\nContent-Disposition: form-data; name=\"", field_name)
    let part2 = http_join3("\"\r\n\r\n", value, "\r\n")
    let closing = http_join3("--", boundary, "--\r\n")
    let body = http_join3(part, part2, closing)
    free(part)
    free(part2)
    free(closing)
    return body
}

function str http_multipart_content_type(str boundary) {
    return http_join2("multipart/form-data; boundary=", boundary)
}
